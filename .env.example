# =============================================================================
# SIGAP — Environment Configuration
# =============================================================================
# Copy file ini ke .env dan isi nilainya
# cp .env.example .env
# =============================================================================

# ── [WAJIB] Google Cloud Project ─────────────────────────────────────────────
# Dapatkan dari: https://console.cloud.google.com
# Format: huruf kecil, angka, dan tanda hubung. Contoh: sigap-hackathon-2024
GCP_PROJECT_ID=your-project-id

# Region Asia (Jakarta)
GCP_REGION=asia-southeast2

# ── [WAJIB untuk EE] Earth Engine ────────────────────────────────────────────
# Sama dengan GCP_PROJECT_ID — EE menggunakan project GCP yang sama
# Setup: https://code.earthengine.google.com/register
# Auth : earthengine authenticate
EE_PROJECT=your-project-id

# ── [WAJIB untuk Gemini] Vertex AI ───────────────────────────────────────────
# Setup: gcloud services enable aiplatform.googleapis.com
# Auth : gcloud auth application-default login
# Model tersedia: gemini-1.5-flash (cepat+murah) atau gemini-1.5-pro (lebih akurat)
GEMINI_MODEL=gemini-1.5-flash

# ── Demo / POC Config ─────────────────────────────────────────────────────────
# Kota fokus demo. Pilihan: semarang | bekasi | jakarta
DEMO_CITY=semarang

# DEMO_MODE=true  → Pakai sample data, skip EE + Gemini (cocok untuk test awal)
# DEMO_MODE=false → Pakai data real dari EE + Gemini (butuh auth lengkap)
DEMO_MODE=true

# ── BMKG ──────────────────────────────────────────────────────────────────────
# Tidak perlu diubah — ini adalah endpoint publik BMKG
BMKG_RSS_URL=https://www.bmkg.go.id/alerts/nowcast/id
BMKG_POLL_INTERVAL_SECONDS=300

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_DIR=data/cache
# Berapa menit hasil EE di-cache sebelum di-refresh (hemat quota EE)
CACHE_TTL_MINUTES=60

# ── Cloud Storage (opsional, untuk production) ────────────────────────────────
# Belum dipakai di POC, tapi siapkan untuk nanti
GCS_BUCKET=sigap-data-bucket
