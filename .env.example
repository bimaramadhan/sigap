# =============================================================================
# SIGAP — Environment Configuration
# =============================================================================
# Copy file ini ke .env dan isi nilainya:
#   Windows: Copy-Item .env.example .env
#   Linux  : cp .env.example .env
# =============================================================================

# ── [WAJIB untuk Gemini GRATIS] Google AI Studio ──────────────────────────────
# Daftar gratis di: https://aistudio.google.com
# Klik "Get API Key" → "Create API key" → copy ke sini
# FREE TIER: 15 request/menit, 1 juta token/hari — cukup untuk demo
GEMINI_API_KEY=your-gemini-api-key

# ── [OPSIONAL] Google Cloud Project (untuk Vertex AI — berbayar) ──────────────
# Hanya dibutuhkan jika TIDAK pakai Google AI Studio di atas
# Jika GEMINI_API_KEY sudah diisi, bagian ini diabaikan
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-southeast2

# ── [OPSIONAL] Earth Engine ───────────────────────────────────────────────────
# Hanya dibutuhkan jika ingin data dari Google Earth Engine
# InaRisk BNPB sudah jadi primary source — EE hanya fallback
# Setup: https://code.earthengine.google.com/register (butuh 1-2 hari approval)
# Auth : earthengine authenticate
EE_PROJECT=your-project-id

# ── Gemini Model ──────────────────────────────────────────────────────────────
# gemini-1.5-flash  = cepat + gratis (recommended untuk demo)
# gemini-1.5-pro    = lebih akurat tapi lebih lambat
# gemini-2.0-flash  = terbaru (cek availability di aistudio.google.com)
GEMINI_MODEL=gemini-1.5-flash

# ── Demo / POC Config ─────────────────────────────────────────────────────────
# Kota fokus demo: semarang | bekasi | jakarta | surabaya
DEMO_CITY=semarang

# DEMO_MODE=true  → Skip Gemini + EE, pakai sample/template (untuk test cepat)
# DEMO_MODE=false → Pakai Gemini + data real (untuk demo sebenarnya)
DEMO_MODE=false

# ── BMKG ──────────────────────────────────────────────────────────────────────
# Tidak perlu diubah — endpoint publik BMKG, tidak butuh auth
BMKG_RSS_URL=https://www.bmkg.go.id/alerts/nowcast/id
BMKG_POLL_INTERVAL_SECONDS=300

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_DIR=data/cache
CACHE_TTL_MINUTES=60

# ── Cloud Storage (untuk production nanti, belum dipakai) ─────────────────────
GCS_BUCKET=sigap-data-bucket
