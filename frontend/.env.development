# VITE_USE_MOCK=false → frontend connect ke FastAPI backend
# VITE_USE_MOCK=true  → pakai mock data hardcoded (tidak butuh backend)
VITE_USE_MOCK=false

# Google OAuth Client ID untuk Login Petugas BPBD (opsional, jika kosong sistem otomatis aktif dengan profil Google Petugas BPBD terverifikasi)
VITE_GOOGLE_CLIENT_ID=
